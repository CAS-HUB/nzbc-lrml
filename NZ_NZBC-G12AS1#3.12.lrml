        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_5.2.7.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:5.2.7.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:pipedWaterSupplySystem</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>waterTank</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:lessThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterTank</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>150 ltr capacity</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:greaterThan"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:waterTank</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>height to breadth ratio of 1:1</ruleml:Data>
                            </ruleml:Not>
                        </ruleml:Not>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:support"/>
                                <ruleml:Var>buvo:waterTank</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g12.as1.f4</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
