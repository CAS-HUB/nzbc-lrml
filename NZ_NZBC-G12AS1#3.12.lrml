                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:pipedWaterSupplySystem</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThan"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:overflowPipeDischargeFlowRate</ruleml:Var>
