        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.6.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.6.2.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterHeaterSystem</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Or>
                            <ruleml:Data>pressureReliefValve</ruleml:Data>
                            <ruleml:Data>expansionControlValve</ruleml:Data>
                        </ruleml:Or>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:has"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pressureReliefValve or expansionControlValve</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>A flow rate capacity of no less than the rate of cold water supply</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:has"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pressureReliefValve or expansionControlValve</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>A maximum pressure rating of no more than the working pressure of the hot water storage vessel</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_c6.6.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:c6.6.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.6.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.6.3.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:waterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>storageWaterHeater</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>expansionControlValve</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Not>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:lessThan"/>
                                    <ruleml:Expr>
                                        <ruleml:Fun iri="fuvo:pressureRating"/>
                                        <ruleml:Atom>
                                            <ruleml:Var>buvo:expansionControlValve</ruleml:Var>
                                        </ruleml:Atom>
                                    </ruleml:Expr>
                                    <ruleml:Data>the water supply pressure to the storage water heater</ruleml:Data>
                                </ruleml:Expr>
                            </ruleml:Not>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThan"/>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="fuvo:pressureRating"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:expansionControlValve</ruleml:Var>
                                    </ruleml:Atom>
                                </ruleml:Expr>
                                <ruleml:Data>pressure rating of the relief valve</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
