        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t4.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t4.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:pressure</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>low</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:waterPressure"/>
                                    <ruleml:Var>buvo:pipe</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>20 kPa</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:waterPressure"/>
                                    <ruleml:Var>buvo:pipe</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>30 kPa</ruleml:Data>
                            </ruleml:Expr>
