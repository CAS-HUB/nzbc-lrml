                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:is"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>flowAndReturnCirculatingSystem</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThan"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:temperature"/>
                                    <ruleml:Var>buvo:water</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>60 degC</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:Not>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_c6.14.4.0.1">
