        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t7.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t7.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:pipeMaterial</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="copper"/>
                        </ruleml:Expr>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pipeDiameter</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="10 mm"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pipeDiameter</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="15 mm"/>
                            </ruleml:Expr>
                        </ruleml:And>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:And>
                            <ruleml:And>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:equal"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:type"/>
                                        <ruleml:Var>buvo:pipe</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data iri="vertical"/>
                                </ruleml:Expr>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:lessThanEqual"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:distanceBetweenSupports</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data iri="1.5 m"/>
                                </ruleml:Expr>
                            </ruleml:And>
                            <ruleml:And>
                                <ruleml:Or>
                                    <ruleml:Expr>
                                        <ruleml:Fun iri="lovo:equal"/>
                                        <ruleml:Atom>
                                            <ruleml:Rel iri="buvo:type"/>
                                            <ruleml:Var>buvo:pipe</ruleml:Var>
                                        </ruleml:Atom>
                                        <ruleml:Data iri="graded"/>
                                    </ruleml:Expr>
                                    <ruleml:Expr>
                                        <ruleml:Fun iri="lovo:equal"/>
                                        <ruleml:Atom>
                                            <ruleml:Rel iri="buvo:type"/>
                                            <ruleml:Var>buvo:pipe</ruleml:Var>
                                        </ruleml:Atom>
                                        <ruleml:Data iri="horizontal"/>
                                    </ruleml:Expr>
                                </ruleml:Or>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:lessThanEqual"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:distanceBetweenSupports</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data iri="1.2 m"/>
                                </ruleml:Expr>
                            </ruleml:And>
                        </ruleml:And>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t7.2">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t7.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:pipeMaterial</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="copper"/>
                        </ruleml:Expr>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pipeDiameter</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="20 mm"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pipeDiameter</ruleml:Var>
