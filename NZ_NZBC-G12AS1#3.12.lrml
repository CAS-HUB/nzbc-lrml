                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>pressureReliefValve</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:energyRating"/>
                                <ruleml:Var>buvo:pressureReliefValve</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>energyRating(energy sources heating the water)</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
