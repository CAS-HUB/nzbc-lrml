        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.5.2.0.1.a.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.5.2.0.1.a.1">
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:can"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:EnergyCutoffDevice</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>be reset manually</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:can"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:EnergyCutoffDevice</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>Disconnect the energy supply before the water temperature exceeds 95¬∞C.</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.6.1.0.1">
