                                    <ruleml:Data>coveredOpening</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:has"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:coveredOpening</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>350 mm clearanceAbove</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
