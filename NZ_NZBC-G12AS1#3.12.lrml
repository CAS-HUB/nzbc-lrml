        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.5.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.5.1.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterHeaterSystem</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Or>
                            <ruleml:Data>electricThermostat</ruleml:Data>
                            <ruleml:Data>energyCutoffDevice</ruleml:Data>
                        </ruleml:Or>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:electricThermostat and energyCutoffDevice</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>nzs6214</ruleml:Data>
                                <ruleml:Data>as1308</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
