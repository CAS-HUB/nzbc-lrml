        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.6.4.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.6.4.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>temperaturePressureReliefValve</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:energyRating"/>
                                <ruleml:Var>buvo:temperaturePressureReliefValve</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>energyRating(energy sources heating the water)</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.6.4.0.1.b.1">
