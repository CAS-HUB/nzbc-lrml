            <ruleml:Rule key="NZBC-NZBC.G12AS1:7.0.1.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:installed"/>
                            <ruleml:Var>buvo:waterSupplySystem</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterSupplySystem</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.b2</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_7.1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:7.1.1.0.1">
