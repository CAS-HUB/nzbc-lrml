                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:hasMoreThan"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:fixture or tank</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>1 supplyPipe</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="fuvo:max"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:25mm, 2 x sum(inletPipeDiameters)</ruleml:Var>
                                    </ruleml:Atom>
                                </ruleml:Expr>
                                <ruleml:Data>airGapSeparation</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:airGapSeparation</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>nzbc.g12.as1.3.5.2</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
