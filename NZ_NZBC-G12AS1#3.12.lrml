        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_5.4.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:5.4.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_c5.4.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:c5.4.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_5.4.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:5.4.3.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:storageWaterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:drain"/>
                                <ruleml:Var>buvo:storageWaterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g12.as1.f7</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_f5">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:f5"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.1.1.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g12.as1.t5</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.1.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.1.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.2.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.2.1.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>storageWaterHeater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:has"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:storageWaterHeater</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>coldWaterSupply</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:pressure"/>
                                    <ruleml:Var>buvo:coldWaterSupply</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>workingPressure</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Or>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:regulatedBy"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:workingPressure"/>
                                        <ruleml:Var>buvo:coldWaterSupply</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>waterTank</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:regulatedBy"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:workingPressure"/>
                                        <ruleml:Var>buvo:coldWaterSupply</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>pressureReducingValve</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:regulatedBy"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:workingPressure"/>
                                        <ruleml:Var>buvo:coldWaterSupply</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>pressureLimitingValve</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:is"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:coldWaterSupply</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>mainsPressureSupply</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                        </ruleml:Or>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t5.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t5.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>Electric low pressure copper storage water heater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:standard</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>NZS 4602</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t5.2">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t5.2">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>Electric storage water heater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:standard</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:And>
                                <ruleml:Data>NZS 4606: Parts 1, 2</ruleml:Data>
                                <ruleml:Data>3</ruleml:Data>
                            </ruleml:And>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t5.3">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t5.3">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>Electric instantaneous water heater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:standard</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>AS/NZS 60335.2.35</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t5.4">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t5.4">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>Gas storage water heater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:standard</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>Gas Regulations</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t5.5">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t5.5">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>Gas instantaneous water heater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:standard</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>Gas Regulations</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_t5.6">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:t5.6">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>Solar storage water heater</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:standard</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>NZS 4613 (see G12/AS2)</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:standard</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>AS/NZS 2712 (see G12/AS2)</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:Or>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.2.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.2.2.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:waterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>storageWaterHeater</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:waterSupply</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>waterTank</ruleml:Data>
                            </ruleml:Not>
                        </ruleml:Not>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:has"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:waterHeater</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>nonReturnValve</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:nonReturnValve</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:And>
                                    <ruleml:Data>nzbc.g12.as1.f7</ruleml:Data>
                                    <ruleml:Data>nzbc.g12.as1.f8</ruleml:Data>
                                    <ruleml:Data>nzbc.g12.as1.f9</ruleml:Data>
                                    <ruleml:Data>nzbc.g12.as1.f10</ruleml:Data>
                                </ruleml:And>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.2.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.2.3.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_6.3.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:6.3.1.0.1">
                <ruleml:if>
                    <ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:waterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>electricStorageWaterHeater</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:waterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>gasStorageWaterHeater</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Or>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:controlledBy"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterHeaterTemperature</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>thermostat on each heating unit</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
