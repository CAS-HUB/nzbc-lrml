                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:locatedIn"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:location"/>
                                <ruleml:Var>buvo:waterTank</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>roofSpace</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterTank</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>cover</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS1_x003A_5.2.5.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS1:5.2.5.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterTank</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>cover</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:cover</ruleml:Var>
