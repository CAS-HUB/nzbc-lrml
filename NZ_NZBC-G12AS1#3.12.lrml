                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>pressureReliefValve</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThan"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pressureReliefValveLocation</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>1 metre from the storage water heater</ruleml:Data>
                            </ruleml:Expr>
