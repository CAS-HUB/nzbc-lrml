    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.B1AS1_x003A_1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.B1AS1:1.1.0.1">
                <ruleml:if>
                    <ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:material"/>
                                <ruleml:Var>buvo:construction</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>masonry</ruleml:Data>
                                <ruleml:Data>timber</ruleml:Data>
                                <ruleml:Data>earth</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:material"/>
                                <ruleml:Var>buvo:construction</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>stucco</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:for"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:construction</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>drain</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:in"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:glazing</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>structure</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Or>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Permission>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:design"/>
                                <ruleml:Var>buvo:structure</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc-b1as1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Permission>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.B1AS1_x003A_1.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.B1AS1:1.2.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:structure</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>chimney</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:size"/>
                                <ruleml:Var>buvo:chimney</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>small</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Permission>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:design"/>
                                <ruleml:Var>buvo:structure</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc-b1as1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Permission>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.B1AS1_x003A_2.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.B1AS1:2.1.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:material"/>
                                <ruleml:Var>buvo:construction</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>masonry</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:define"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:x</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>_new</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:x</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzs4229.clause7.8.3</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:content"/>
                                    <ruleml:Var>buvo:x</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>deleted</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:replacedWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:content"/>
                                    <ruleml:Var>buvo:x</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>rule</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:key"/>
                                    <ruleml:Var>buvo:rule</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>2.1.1.1</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.B1AS1_x003A_2.1.1.1">
            <ruleml:Rule key="NZBC-NZBC.B1AS1:2.1.1.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:material"/>
                                <ruleml:Var>buvo:slab</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>concrete</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:construction"/>
                                <ruleml:Var>buvo:slab</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>slabOnGround</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:slabOnGround</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>reinforcing</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:slab</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>outsideEdge</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:within"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:extension"/>
                                    <ruleml:Var>buvo:reinforcing</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>outsideEdge</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:extension</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>75 mm</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:reinforcing</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>meshSheet</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:meshSheet</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>weldedGrade500E</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:weight"/>
                                    <ruleml:Var>buvo:meshSheet</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>2.27 kg/m^2</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:weight"/>
                                    <ruleml:Var>buvo:meshSheet</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>1.14 kg/m^2 each direction</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:has"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:joint"/>
                                    <ruleml:Var>buvo:meshSheet</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>overlap</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:inBetween"/>
