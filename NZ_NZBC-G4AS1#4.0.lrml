    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G4AS1#4.0_r1.2.2.1">
            <ruleml:Rule key="NZ_NZBC-G4AS1#4.0_r1.2.2.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Expr>
                                <ruleml:Fun iri="fuvo:count"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:occupantLoad"/>
                                    <ruleml:Var iri="buvo:space"/>
                                </ruleml:Atom>
                            </ruleml:Expr>
                            <ruleml:Data xsi:type="xs:integer">0</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Expr>
                                <ruleml:Fun iri="fuvo:count"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:opening"/>
                                    <ruleml:Var iri="buvo:wall"/>
                                </ruleml:Atom>
                            </ruleml:Expr>
                            <ruleml:Data xsi:type="xs:integer">0</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:isExternal"/>
                                <ruleml:Var iri="buvo:wall"/>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="lkm:boolean">true</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:ratio"/>
                                <ruleml:Var iri="buvo:ventAreaToFloorArea"/>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:decimal">0.05</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G4AS1#4.0_t1.1">
            <ruleml:Rule key="NZ_NZBC-G4AS1#4.0_t1.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:is"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:accommodationUnitType"/>
                            <ruleml:Var iri="buvo:householdUnit"/>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="xs:string">studio</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:count"/>
                            <ruleml:Var iri="buvo:occupant"/>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="xs:integer">2</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G4AS1#4.0_t1.2">
            <ruleml:Rule key="NZ_NZBC-G4AS1#4.0_t1.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:accommodationUnitType"/>
                                <ruleml:Var iri="buvo:householdUnit"/>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">bedroom</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:define"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:count"/>
                                <ruleml:Var iri="buvo:bedroom"/>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">n</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:count"/>
                            <ruleml:Var iri="buvo:occupant"/>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="lkm:expression">
                            <lkm:value>n+1</lkm:value>
                        </ruleml:Data>
                    </ruleml:Expr>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G4AS1#4.0_t2.1">
            <ruleml:Rule key="NZ_NZBC-G4AS1#4.0_t2.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:location"/>
                                <ruleml:Var iri="buvo:trickleVentilator"/>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">High and low level</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:count"/>
                                <ruleml:Var iri="buvo:occupant"/>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:integer">1</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:equivalentAerodynamicArea"/>
                            <ruleml:Var iri="buvo:trickleVentilator"/>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="lkm:measurement">
                            <lkm:baseUnit lkm:kind="metre" lkm:prefix="milli" lkm:exponent="2.0"/>
                            <lkm:value>4000.0</lkm:value>
                        </ruleml:Data>
                    </ruleml:Expr>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
