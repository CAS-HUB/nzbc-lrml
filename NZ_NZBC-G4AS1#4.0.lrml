    <lrml:Prefix refID="https://lovo.acabim.com" pre="lovo"/>
    <lrml:Prefix pre="fuvo" refID="https://fuvo.acabim.com"/>
    <lrml:Jurisdictions>
        <lrml:Jurisdiction sameAs="http://example.org/jurisdiction#newzealand" key="NZ"/>
    </lrml:Jurisdictions>
    <lrml:LegalSources key="legal-source">
        <lrml:LegalSource key="NZBC.G4AS1" sameAs="https://www.building.govt.nz/assets/Uploads/building-code-compliance/g-services-and-facilities/g4-ventilation/asvm/g4-ventilation-4th-edition.pdf"/>
    </lrml:LegalSources>
    <lrml:Context>
        <lrml:Association>
            <lrml:appliesSource keyref="r1.2.2"/>
