    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_1.0.1.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:1.0.1.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:lessThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:buildingStorey"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>3</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:aboveGround"/>
                        </ruleml:Expr>
                        <ruleml:Or>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:within"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:foulWaterPipework</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>building</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:on"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:foulWaterPipework</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>building</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:Or>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:complyWith</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g13as1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_1.0.2.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:1.0.2.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Or>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:specialisedTypes"/>
                                    <ruleml:Var>buvo:sanitaryFixture</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>TRUE</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:specialisedTypes"/>
                                    <ruleml:Var>buvo:sanitaryAppliance</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>TRUE</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:within"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>hospitalsLaboratoriesFactories</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                            </ruleml:Expr>
                        </ruleml:Not>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_1.0.2.2">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:1.0.2.2">
                <ruleml:if>
                    <ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:conveyance"/>
                                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>TRUE</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:conveyance"/>
                                <ruleml:Var>buvo:chemicalWaste</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>TRUE</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:conveyance"/>
                                <ruleml:Var>buvo:toxicWaste</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>TRUE</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:conveyance"/>
                                <ruleml:Var>buvo:"wastes which cannot be discharged to a sewer without pretreatment"</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>TRUE</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Or>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                            </ruleml:Expr>
                        </ruleml:Not>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_1.0.3.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:1.0.3.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_c1.0.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:c1.0.3.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_2.1.1.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:2.1.1.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:sanitaryPlumbingSystem</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>gravityFlow</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:materials</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g13as1.t1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_3.1.1.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:3.1.1.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:from"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:dischargePoint</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Or>
                            <ruleml:Data>sanitaryFixture</ruleml:Data>
                            <ruleml:Data>sanitaryAppliance</ruleml:Data>
                        </ruleml:Or>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThanEqual"/>
                            <ruleml:Expr>
                                <ruleml:Fun iri="fuvo:count"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:waterTrap</ruleml:Var>
                                </ruleml:Atom>
                            </ruleml:Expr>
                            <ruleml:Data>1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_3.1.2.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:3.1.2.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:waterTrap</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:feature"/>
                                    <ruleml:Var>buvo:waterTrap</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>removable</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:feature"/>
                                <ruleml:Var>buvo:waterTrap</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>ableToBeDismantled</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:feature"/>
                                <ruleml:Var>buvo:waterTrap</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>hasCleaningEye</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Or>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_c3.1.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:c3.1.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS1_x003A_t1.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS1:t1.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:material</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>pipesAndFittings</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:material</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>airAdmittanceValves</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
