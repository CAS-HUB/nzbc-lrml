    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZ_RMA-AUP_x0023_14_r27.6.3.7">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_RMA-AUP%2314:rule:NZ_RMA-AUP%2314_r27.6.3.7">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThanEqual"/>
                            <ruleml:Expr>
                                <ruleml:Fun iri="fuvo:count"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:space"/>
                                    <ruleml:Var>buvo:parking</ruleml:Var>
                                </ruleml:Atom>
                            </ruleml:Expr>
                            <ruleml:Data xsi:type="xs:integer">10</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:usage"/>
                                <ruleml:Var>buvo:parking</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">evening</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Expr>
                                <ruleml:Fun iri="fuvo:count"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:lighting</ruleml:Var>
                                </ruleml:Atom>
                            </ruleml:Expr>
                            <ruleml:Data xsi:type="xs:integer">0</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_RMA-AUP_x0023_14_t6.2.1.2">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_RMA-AUP%2314:rule:NZ_RMA-AUP%2314_t6.2.1.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:zone"/>
                                <ruleml:Var>buvo:site</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">business - city centre</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:activity"/>
                                <ruleml:Var>buvo:site</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">dwelling</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:gfa"/>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:decimal">75.0</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThan"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:gfa"/>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:decimal">90.0</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:define"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:numberOfDwellings"/>
                                    <ruleml:Var>buvo:site</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">n</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:And>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:lessThanEqual"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:parkingRate"/>
                            <ruleml:Var>buvo:site</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="lkm:expression">
                            <lkm:value>1.4 * n</lkm:value>
                        </ruleml:Data>
                    </ruleml:Expr>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_RMA-AUP_x0023_14_t6.2.2.2">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_RMA-AUP%2314:rule:NZ_RMA-AUP%2314_t6.2.2.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:zone"/>
                                <ruleml:Var>buvo:site</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">Centre Fringe Office Control</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:activity"/>
                                <ruleml:Var>buvo:site</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">office</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:define"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:gfa"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">fa</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:greaterThanEqual"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:parkingRate"/>
                            <ruleml:Var>buvo:site</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="lkm:expression">fa/60m^2</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
