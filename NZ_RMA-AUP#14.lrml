            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_RMA-AUP%2314:rule:NZ_RMA-AUP%2314_t6.2.1.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:zone"/>
                                <ruleml:Var>buvo:site</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">business - city centre</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:activity"/>
                                <ruleml:Var>buvo:site</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">dwelling</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThan"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:gfa"/>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="lkm:measurement">
                                    <lkm:baseUnit lkm:kind="metre" lkm:exponent="2.0"/>
                                    <lkm:value>90.0</lkm:value>
                                </ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:define"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:numberOfDwellings"/>
                                    <ruleml:Var>buvo:site</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">n</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:And>
                    </ruleml:And>
