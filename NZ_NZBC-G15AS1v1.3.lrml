				</ruleml:if>
				<ruleml:then>
					<lrml:Permission>
						<ruleml:Atom>
							<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
							<ruleml:Data iri="refrigerated"/>
						</ruleml:Atom>
