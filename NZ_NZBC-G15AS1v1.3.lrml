					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:located"/>
								<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
								<ruleml:Data iri="openAir"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<ruleml:Atom/>
				</ruleml:then>
