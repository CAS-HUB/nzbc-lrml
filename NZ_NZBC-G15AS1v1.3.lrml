		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.7">
			<ruleml:Rule key="NZBC-G15AS1:3.0.7">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:Atom>
						<ruleml:Var>buvo:type</ruleml:Var>
						<ruleml:Data iri="common"/>
						<ruleml:Operator iri="lovo:equal"/>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Expr>
							<ruleml:Fun/>
						</ruleml:Expr>
						<ruleml:Atom>
							<ruleml:Var>buvo:waterSupplyTap</ruleml:Var>
							<ruleml:Data iri="1"/>
							<ruleml:Operator iri="lovo:greaterThan"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:waterSupplyTap</ruleml:Var>
								<ruleml:Data iri="nzbc-g12"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.8">
			<ruleml:Rule key="NZBC-G15AS1:3.0.8">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:location</ruleml:Var>
							<ruleml:Data iri="withinBuilding"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:complyWith"/>
							<ruleml:Var>buvo:ventilation</ruleml:Var>
							<ruleml:Data iri="nzbc-g4"/>
						</ruleml:Atom>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.9">
			<ruleml:Rule key="NZBC-G15AS1:3.0.9">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:ventilation</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:type</ruleml:Var>
							<ruleml:Data iri="mechanicalVentilation"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:ventilationRate</ruleml:Var>
							<ruleml:Data iri="6 air changes per hour"/>
							<ruleml:Operator iri="lovo:greaterThanEqual"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:airPressure</ruleml:Var>
								<ruleml:Data iri="ambientAirPressure"/>
								<ruleml:Operator iri="lovo:lessThan"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:towards"/>
								<ruleml:Var>buvo:discharge</ruleml:Var>
								<ruleml:Data iri="safePlace"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.10">
			<ruleml:Rule key="NZBC-G15AS1:3.0.10">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:access</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:from</ruleml:Var>
							<ruleml:Data iri="wasteStorageArea"/>
						</ruleml:Atom>
					</ruleml:And>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:to</ruleml:Var>
							<ruleml:Data iri="collectionVehicle"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:complyWith"/>
							<ruleml:Var>buvo:accessRoute</ruleml:Var>
							<ruleml:Data iri="nzbc-d1"/>
						</ruleml:Atom>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.1.1">
			<ruleml:Rule key="NZBC-G15AS1:3.1.1">
				<!-- comment -->
