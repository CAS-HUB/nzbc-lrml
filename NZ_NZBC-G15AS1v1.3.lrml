		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_4.0.2.3">
			<ruleml:Rule key="NZBC-G15AS1:4.0.2.3">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:openingDiameter</ruleml:Var>
							<ruleml:Data iri="250 mm"/>
							<ruleml:Operator iri="lovo:lessThanEqual"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:hasDoor</ruleml:Var>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:door</ruleml:Var>
								<ruleml:Data iri="selfClosing"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:door</ruleml:Var>
								<ruleml:Data iri="tightFitting"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surfaceFinish</ruleml:Var>
								<ruleml:Data iri="easilyCleaned"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surface</ruleml:Var>
								<ruleml:Data iri="materials"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surface</ruleml:Var>
								<ruleml:Data iri="galvanisedSteelSheet"/>
								<ruleml:Operator iri="lovo:similarTo"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surface</ruleml:Var>
								<ruleml:Data iri="ceramicTiles"/>
								<ruleml:Operator iri="lovo:similarTo"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:located"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="dwelling"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:located"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="enclosedStairAccess"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:adjacent"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="habitableSpace"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:adjacent"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="foodPreparationArea"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:ventilation</ruleml:Var>
								<ruleml:Data iri="adequate"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:located"/>
								<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
								<ruleml:Data iri="openAir"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:ventilation</ruleml:Var>
								<ruleml:Data iri="nzbc-g4"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_4.0.3">
			<ruleml:Rule key="NZBC-G15AS1:4.0.3">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:solidWasteChute</ruleml:Var>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:waterSupplyTap</ruleml:Var>
							<ruleml:Data iri="1 per every second floor"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:adjacent"/>
								<ruleml:Var>buvo:waterSupplyTap</ruleml:Var>
								<ruleml:Data iri="solidWasteChute"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_Figure2.1">
