		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_Figure2.4">
			<ruleml:Rule key="NZBC-G15AS1:Figure2.4">
				<!-- comment -->
