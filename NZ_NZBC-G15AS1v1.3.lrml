				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.6_x0020_">
			<ruleml:Rule key="NZBC-G15AS1:3.0.6 ">
