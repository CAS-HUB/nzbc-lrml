	<lrml:Statements>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_1.0.1_x0020_">
			<ruleml:Rule key="NZBC-G15AS1:1.0.1 ">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:multiUnitDwelling</ruleml:Var>
					</ruleml:Atom>
					<ruleml:Or>
						<ruleml:Atom>
							<ruleml:Var>buvo:groupDwelling</ruleml:Var>
						</ruleml:Atom>
					</ruleml:Or>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:disposalMethod</ruleml:Var>
							<ruleml:Data iri="moveableContainer"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:volume()"/>
							<ruleml:Var>buvo:moveableContainer</ruleml:Var>
							<ruleml:Data iri="80 l per dwellingUnit"/>
							<ruleml:Operator iri="lovo:greaterThanEqual"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_1.0.2">
			<ruleml:Rule key="NZBC-G15AS1:1.0.2">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
						<ruleml:Data iri="common"/>
						<ruleml:Operator iri="lovo:equal"/>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:located"/>
							<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
							<ruleml:Data iri="withinBuilding"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:length"/>
							<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
							<ruleml:Data iri="0.5 m per householdUnit"/>
							<ruleml:Operator iri="lovo:greaterThanEqual"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:width"/>
							<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
							<ruleml:Data iri="0.5 m per householdUnit"/>
							<ruleml:Operator iri="lovo:greaterThanEqual"/>
						</ruleml:Atom>
					</ruleml:And>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:height"/>
							<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
							<ruleml:Data iri="1 m per householdUnit"/>
							<ruleml:Operator iri="lovo:greaterThanEqual"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_1.0.3">
			<ruleml:Rule key="NZBC-G15AS1:1.0.3">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:type</ruleml:Var>
							<ruleml:Data iri="common"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:location</ruleml:Var>
							<ruleml:Data iri="withinBuilding"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:complyWith"/>
							<ruleml:Var>buvo:ventilation</ruleml:Var>
							<ruleml:Data iri="nzbc-g4"/>
						</ruleml:Atom>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_2.0.1">
			<ruleml:Rule key="NZBC-G15AS1:2.0.1">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:multiUnitDwelling</ruleml:Var>
					</ruleml:Atom>
					<ruleml:Or>
						<ruleml:Atom>
							<ruleml:Var>buvo:groupDwelling</ruleml:Var>
						</ruleml:Atom>
					</ruleml:Or>
				</ruleml:if>
				<ruleml:then>
					<lrml:Prohibition>
						<ruleml:Atom>
							<ruleml:Var>buvo:carryDistance</ruleml:Var>
							<ruleml:Data iri="30 m"/>
							<ruleml:Operator iri="lovo:greaterThan"/>
						</ruleml:Atom>
					</lrml:Prohibition>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.1.1">
			<ruleml:Rule key="NZBC-G15AS1:3.0.1.1">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:type</ruleml:Var>
							<ruleml:Data iri="common"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:interiorSurface</ruleml:Var>
							<ruleml:Data iri="easilyCleaned"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.1.2">
			<ruleml:Rule key="NZBC-G15AS1:3.0.1.2">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:type</ruleml:Var>
							<ruleml:Data iri="common"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:enclosure</ruleml:Var>
							<ruleml:Data iri="fullyEnclosed"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<ruleml:And>
						<ruleml:Not>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:adjacent"/>
								<ruleml:Var>buvo:location</ruleml:Var>
								<ruleml:Data iri="habitableSpace"/>
							</ruleml:Atom>
						</ruleml:Not>
					</ruleml:And>
					<ruleml:And>
						<ruleml:Not>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:adjacent"/>
								<ruleml:Var>buvo:location</ruleml:Var>
								<ruleml:Data iri="foodPreparationArea"/>
							</ruleml:Atom>
						</ruleml:Not>
					</ruleml:And>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.1.3">
			<ruleml:Rule key="NZBC-G15AS1:3.0.1.3">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:type</ruleml:Var>
							<ruleml:Data iri="common"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Not>
							<ruleml:Atom>
								<ruleml:Var>buvo:exposure</ruleml:Var>
								<ruleml:Data iri="highTemperature"/>
							</ruleml:Atom>
						</ruleml:Not>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.1.4">
			<ruleml:Rule key="NZBC-G15AS1:3.0.1.4">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wasteStorageArea</ruleml:Var>
					</ruleml:Atom>
					<ruleml:Atom>
						<ruleml:Var>buvo:type</ruleml:Var>
						<ruleml:Data iri="common"/>
						<ruleml:Operator iri="lovo:equal"/>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:visualImpact</ruleml:Var>
							<ruleml:Data iri="low"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:screenedFrom"/>
								<ruleml:Var>buvo:visualExposure</ruleml:Var>
								<ruleml:Data iri="habitableSpace"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<ruleml:Atom/>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.2">
			<ruleml:Rule key="NZBC-G15AS1:3.0.2">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:floor</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:material</ruleml:Var>
							<ruleml:Data iri="concrete"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:location</ruleml:Var>
							<ruleml:Data iri="wasteStorageArea"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:surfaceFinish</ruleml:Var>
							<ruleml:Data iri="U5"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:slope</ruleml:Var>
								<ruleml:Data iri="1 in 50"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:towards"/>
								<ruleml:Var>buvo:slope</ruleml:Var>
								<ruleml:Data iri="floorWaste"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:floorWaste</ruleml:Var>
								<ruleml:Data iri="nzbc-g13"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.3">
			<ruleml:Rule key="NZBC-G15AS1:3.0.3">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:wall</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:location</ruleml:Var>
							<ruleml:Data iri="wasteStorageArea"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:material</ruleml:Var>
							<ruleml:Data iri="concrete"/>
							<ruleml:Operator iri="lovo:equal"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:Or>
							<ruleml:Atom>
								<ruleml:Var>buvo:material</ruleml:Var>
								<ruleml:Data iri="galvanisedSteelSheet"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:Or>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:Or>
							<ruleml:Atom>
								<ruleml:Var>buvo:material</ruleml:Var>
								<ruleml:Data iri="vinyl"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:Or>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:Or>
							<ruleml:Atom>
								<ruleml:Var>buvo:material</ruleml:Var>
								<ruleml:Data iri="concrete"/>
								<ruleml:Operator iri="lovo:similarTo"/>
							</ruleml:Atom>
						</ruleml:Or>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:Or>
							<ruleml:Atom>
								<ruleml:Var>buvo:material</ruleml:Var>
								<ruleml:Data iri="galvanisedSteelSheet"/>
								<ruleml:Operator iri="lovo:similarTo"/>
							</ruleml:Atom>
						</ruleml:Or>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:Or>
							<ruleml:Atom>
								<ruleml:Var>buvo:material</ruleml:Var>
								<ruleml:Data iri="vinyl"/>
								<ruleml:Operator iri="lovo:similarTo"/>
							</ruleml:Atom>
						</ruleml:Or>
					</lrml:Obligation>
					<ruleml:Atom/>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.4">
			<ruleml:Rule key="NZBC-G15AS1:3.0.4">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:window</ruleml:Var>
					</ruleml:Atom>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:orientation</ruleml:Var>
							<ruleml:Data iri="north"/>
						</ruleml:Atom>
					</ruleml:And>
					<ruleml:And>
						<ruleml:Atom>
							<ruleml:Var>buvo:location</ruleml:Var>
							<ruleml:Data iri="wasteStorageArea"/>
						</ruleml:Atom>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Rel iri="fuvo:screenedFrom"/>
							<ruleml:Var>buvo:thermalExposure</ruleml:Var>
							<ruleml:Data iri="directSunlight"/>
						</ruleml:Atom>
					</lrml:Obligation>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_3.0.5">
			<ruleml:Rule key="NZBC-G15AS1:3.0.5">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:solidWaste</ruleml:Var>
					</ruleml:Atom>
					<ruleml:Atom>
						<ruleml:Var>buvo:type</ruleml:Var>
						<ruleml:Data iri="perishable"/>
