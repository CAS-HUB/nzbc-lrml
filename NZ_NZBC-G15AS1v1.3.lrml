		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_4.0.1">
			<ruleml:Rule key="NZBC-G15AS1:4.0.1">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:solidWasteChute</ruleml:Var>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:internalDiameter</ruleml:Var>
							<ruleml:Data iri="450 mm"/>
							<ruleml:Operator iri="lovo:greaterThanEqual"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:cleaningMode</ruleml:Var>
								<ruleml:Data iri="selfCleaning"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:orientation</ruleml:Var>
								<ruleml:Data iri="vertical"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:interiorSurface</ruleml:Var>
								<ruleml:Data iri="smooth"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:hasVent</ruleml:Var>
								<ruleml:Data iri="aboveRoofLine"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:hasVent</ruleml:Var>
								<ruleml:Data iri="bottomOfChute"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:disposalMethod</ruleml:Var>
								<ruleml:Data iri="moveableContainer"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:located"/>
								<ruleml:Var>buvo:moveableContainer</ruleml:Var>
								<ruleml:Data iri="room"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.1"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.2"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.3"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.4"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.5"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.6"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.7"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.8"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:complyWith"/>
								<ruleml:Var>buvo:room</ruleml:Var>
								<ruleml:Data iri="lrml:PrescriptiveStatements nzbcg15.3.0.9"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_4.0.2.1">
			<ruleml:Rule key="NZBC-G15AS1:4.0.2.1">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:openingDiameter</ruleml:Var>
							<ruleml:Data iri="250 mm"/>
							<ruleml:Operator iri="lovo:lessThanEqual"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:hasDoor</ruleml:Var>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:door</ruleml:Var>
								<ruleml:Data iri="selfClosing"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:door</ruleml:Var>
								<ruleml:Data iri="tightFitting"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surfaceFinish</ruleml:Var>
								<ruleml:Data iri="easilyCleaned"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surface</ruleml:Var>
								<ruleml:Data iri="galvanisedSteelSheet"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:located"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="dwelling"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:located"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="enclosedStairAccess"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:adjacent"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="habitableSpace"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:adjacent"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="foodPreparationArea"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:ventilation</ruleml:Var>
								<ruleml:Data iri="adequate"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Rel iri="fuvo:located"/>
								<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
								<ruleml:Data iri="openAir"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<ruleml:Atom/>
				</ruleml:then>
			</ruleml:Rule>
		</lrml:PrescriptiveStatement>
		<lrml:PrescriptiveStatement key="NZBC-G15AS1_x003A_4.0.2.2">
			<ruleml:Rule key="NZBC-G15AS1:4.0.2.2">
				<!-- comment -->
				<ruleml:if>
					<ruleml:Atom>
						<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
					</ruleml:Atom>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Atom>
							<ruleml:Var>buvo:openingDiameter</ruleml:Var>
							<ruleml:Data iri="250 mm"/>
							<ruleml:Operator iri="lovo:lessThanEqual"/>
						</ruleml:Atom>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:hasDoor</ruleml:Var>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:door</ruleml:Var>
								<ruleml:Data iri="selfClosing"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:door</ruleml:Var>
								<ruleml:Data iri="tightFitting"/>
								<ruleml:Operator iri="lovo:equal"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surfaceFinish</ruleml:Var>
								<ruleml:Data iri="easilyCleaned"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Obligation>
					<lrml:Permission>
						<ruleml:And>
							<ruleml:Atom>
								<ruleml:Var>buvo:surface</ruleml:Var>
								<ruleml:Data iri="ceramicTiles"/>
							</ruleml:Atom>
						</ruleml:And>
					</lrml:Permission>
					<lrml:Obligation>
						<ruleml:And>
							<ruleml:Not>
								<ruleml:Atom>
									<ruleml:Rel iri="fuvo:located"/>
									<ruleml:Var>buvo:sideEntryHopper</ruleml:Var>
									<ruleml:Data iri="dwelling"/>
								</ruleml:Atom>
							</ruleml:Not>
						</ruleml:And>
