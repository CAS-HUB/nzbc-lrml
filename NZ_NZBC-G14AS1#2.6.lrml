    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_r1.1.1">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_r1.1.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:waste</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">industrialLiquid</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Or>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:system</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">collection</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:system</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">storage</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:system</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">treatment</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:system</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">dispiosal</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:Or>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:design"/>
                                    <ruleml:Var>buvo:system</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">specificDesign</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:design"/>
                                    <ruleml:Var>buvo:system</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">nzbc-g14vm1</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_r1.1.2">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_r1.1.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:type"/>
                                <ruleml:Var>buvo:waste</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">industrialLiquid</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:hazardous"/>
                                <ruleml:Var>buvo:waste</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:boolean">true</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <ruleml:And>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:collection"/>
                                        <ruleml:Var>buvo:system</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data xsi:type="xs:string">nzbc-g14vm1</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:collection"/>
                                        <ruleml:Var>buvo:system</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data xsi:type="xs:string">nzbc-f3</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                        </ruleml:And>
                        <ruleml:And>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:storage"/>
                                        <ruleml:Var>buvo:system</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data xsi:type="xs:string">nzbc-g14vm1</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:storage"/>
                                        <ruleml:Var>buvo:system</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data xsi:type="xs:string">nzbc-f3</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                        </ruleml:And>
                        <ruleml:And>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:treatment"/>
                                        <ruleml:Var>buvo:system</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data xsi:type="xs:string">nzbc-g14vm1</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:treatment"/>
                                        <ruleml:Var>buvo:system</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data xsi:type="xs:string">nzbc-f3</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                        </ruleml:And>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_t1.3.1.1">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_t1.3.1.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:tank</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="xs:string">seismicRestraint</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:tank</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">nzbc-b1</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:tank</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">nzbc-b1vm1</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_t1.3.1.2">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_t1.3.1.2">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:is"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:access</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="xs:string">vehicle</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:access</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">nzbc-d1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_t1.3.1.3">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_t1.3.1.3">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:is"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:type"/>
                            <ruleml:Var>buvo:Ind.LiquidWaste</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="xs:string">hazardous</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:collectionMethod</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data xsi:type="xs:string">nzbc-f3</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:storageMethod</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">nzbc-f3</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_t1.3.1.4">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_t1.3.1.4">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:risk"/>
                            <ruleml:Var>buvo:waterSupply</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data xsi:type="xs:string">contamination</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:waterSupply</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data xsi:type="xs:string">nzbc-g12</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G14AS1_x0023_2.6_t1.3.1.5">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G14AS1%232.6:rule:NZ_NZBC-G14AS1%232.6_t1.3.1.5">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:storageTank</ruleml:Var>
                            </ruleml:Atom>
