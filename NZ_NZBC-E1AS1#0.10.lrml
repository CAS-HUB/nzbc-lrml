                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:width"/>
                                    <ruleml:Var>buvo:b</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>(d +  200) mm</ruleml:Data>
