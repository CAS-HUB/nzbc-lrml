            <ruleml:Rule key="NZBC-NZBC.E1AS1:3.9.2.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:pipe</ruleml:Var>
