        <lrml:PrescriptiveStatement key="NZBC-NZBC.E1AS1_x003A_1.0.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.E1AS1:1.0.1.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:lessThanEqual"/>
