                            <ruleml:Atom>
                                <ruleml:Var>buvo:gradient</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="1/90"/>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.E1AS1_x003A_t2.2">
            <ruleml:Rule key="NZBC-NZBC.E1AS1:t2.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:lessThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:drainInternalDiameter</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="100 mm"/>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:drainInternalDiameter</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="85 mm"/>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:gradient</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="1/120"/>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.E1AS1_x003A_t2.3">
            <ruleml:Rule key="NZBC-NZBC.E1AS1:t2.3">
