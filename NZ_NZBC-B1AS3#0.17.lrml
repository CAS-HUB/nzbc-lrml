        <lrml:PrescriptiveStatement key="NZBC-NZBC.B1AS3_x003A_1.7.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.B1AS3:1.7.2.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:inBetween"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:exists"/>
                            <ruleml:Var>buvo:packer</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:And>
                            <ruleml:Data>chimney</ruleml:Data>
                            <ruleml:Data>building</ruleml:Data>
                        </ruleml:And>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <ruleml:Or>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:is"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:construction"/>
                                        <ruleml:Var>buvo:packer</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Or>
                                        <ruleml:Data>Concrete, brick, steel (angle, channel</ruleml:Data>
                                        <ruleml:Data>Z section)</ruleml:Data>
                                    </ruleml:Or>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:construction"/>
                                    <ruleml:Var>buvo:packer</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>any insulating material which has a long term operating temperature of no less than 150√Ç¬∞C</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:secured"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:packer</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>inPlace</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:capableOf"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:packer</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>withstanding a compressive force of 10 kN without shortening by more than 1.5 mm</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
