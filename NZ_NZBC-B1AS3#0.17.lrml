    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.B1AS3_x003A_1.1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.B1AS3:1.1.1.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:construction"/>
                                <ruleml:Var>buvo:chimney</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>brickwork</ruleml:Data>
                                <ruleml:Data>concrete</ruleml:Data>
                                <ruleml:Data>precastPumiceConcrete</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:connectTo"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:chimney</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>building</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:construction"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>timberFrame</ruleml:Data>
                                <ruleml:Data>masonry</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:construction"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>NZS3604</ruleml:Data>
                                <ruleml:Data>NZS4229</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
