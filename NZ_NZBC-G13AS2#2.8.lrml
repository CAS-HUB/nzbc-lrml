        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_3.4.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:3.4.3.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:dischargeTo"/>
                        <ruleml:Expr>
                            <ruleml:Fun iri="fuvo:forEach"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:sanitaryFixture</ruleml:Var>
                            </ruleml:Atom>
                        </ruleml:Expr>
                        <ruleml:Data>greaseTrap</ruleml:Data>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Expr>
                                <ruleml:Fun iri="fuvo:sum"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:capacity"/>
                                    <ruleml:Var>buvo:sanitaryFixture</ruleml:Var>
                                </ruleml:Atom>
                            </ruleml:Expr>
                            <ruleml:Data>c1</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:capacity"/>
                                    <ruleml:Var>buvo:greaseTrap</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>2*(c1 + c2)</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:capacity"/>
                                    <ruleml:Var>buvo:greaseTrap</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>100 litres</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_3.4.4.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:3.4.4.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:activity"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>restaurant</ruleml:Data>
                                <ruleml:Data>café</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>seating</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:quantity"/>
                                <ruleml:Var>buvo:seating</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>s1</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:capacity"/>
                                    <ruleml:Var>buvo:greaseTrap</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>s1 * 5 litres</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Expr>
