        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_2.1.1.0.1.a.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:2.1.1.0.1.a.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:location"/>
                            <ruleml:Var>buvo:drain</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>belowGround</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:beddingFill</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>clean</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:beddingFill</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>granular</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:beddingFill</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>non-cohesive</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:lessThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:size"/>
                                <ruleml:Var>buvo:beddingFillParticle</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>20 mm</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_2.1.1.0.1.b.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:2.1.1.0.1.b.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:location"/>
                            <ruleml:Var>buvo:drain</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>belowGround</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:selectedFill</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>clean</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:fill</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>fine-grained</ruleml:Data>
                                <ruleml:Data>granular</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:includes"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:fill</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Or>
                                    <ruleml:Data>topsoil</ruleml:Data>
                                    <ruleml:Data>rubbish</ruleml:Data>
                                </ruleml:Or>
                            </ruleml:Not>
                        </ruleml:Not>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:lessThanEqual"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:size"/>
                                <ruleml:Var>buvo:selectedFillParticle</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>20 mm</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_2.1.1.0.1.c.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:2.1.1.0.1.c.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:location"/>
                            <ruleml:Var>buvo:drain</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>belowGround</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:ordinaryFill</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>excavatedMaterial</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_3.1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:3.1.1.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:medium"/>
                                <ruleml:Var>buvo:drain</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>foulWater</ruleml:Data>
                        </ruleml:Expr>
                        <lrml:Obligation>
                            <ruleml:Not>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:has"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:drain</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>blockage</ruleml:Data>
                                </ruleml:Expr>
                            </ruleml:Not>
                        </lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:system"/>
                                <ruleml:Var>buvo:drain</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>changesOfDirection</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:pipe"/>
                                <ruleml:Var>buvo:drain</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>bend</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:inBetween"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:section"/>
                                <ruleml:Var>buvo:pipe</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>bends</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="fuvo:min"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:quantity"/>
                                        <ruleml:Var>buvo:changesOfDirection</ruleml:Var>
                                    </ruleml:Atom>
                                </ruleml:Expr>
                                <ruleml:Data>TRUE</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="fuvo:max"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:radius"/>
                                        <ruleml:Var>buvo:bend</ruleml:Var>
                                    </ruleml:Atom>
                                </ruleml:Expr>
                                <ruleml:Data>TRUE</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:section"/>
                                    <ruleml:Var>buvo:pipe</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>straight</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_3.2.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:3.2.1.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:include"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:drain</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>connection</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:connection</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>ventPipe</ruleml:Data>
                            </ruleml:Not>
                        </ruleml:Not>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:connection</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>sweepJunction</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:connection</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>obliqueJunction</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:angle"/>
                                    <ruleml:Var>buvo:connection</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>60°</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_t1.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:t1.1">
                <ruleml:if>
                    <ruleml:Expr>
