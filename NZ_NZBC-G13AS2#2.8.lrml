                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:drain</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g13as2</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G13AS2_x003A_1.0.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G13AS2:1.0.2.0.1">
