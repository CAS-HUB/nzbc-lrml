                                <ruleml:Fun iri="lovo:greaterThan"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:h1 - h2</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>2.5m</ruleml:Data>
