            <lrml:Permission>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:disposalMethod"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:Data iri="sewer"/>
                <Operator iri="lovo:dischargeInto"/>
              </ruleml:Atom>
            </lrml:Permission>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:disposalSystem"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:Data iri="nzbc-g13"/>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Permission>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:disposalMethod"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:Data iri="sewer"/>
                <Operator iri="lovo:dischargeInto"/>
