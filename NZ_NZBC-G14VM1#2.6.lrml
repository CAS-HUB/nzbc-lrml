              <Operator iri="lovo:is"/>
            </ruleml:Atom>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:protection"/>
                <ruleml:Var>buvo:waterSupply</ruleml:Var>
                <ruleml:Data iri="contamination"/>
                <Operator iri="lovo:from"/>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:installation"/>
                <ruleml:Var>buvo:collectionFacility</ruleml:Var>
                <ruleml:Data iri="nzbc-g12"/>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:installation"/>
                <ruleml:Var>buvo:storageFacility</ruleml:Var>
                <ruleml:Data iri="nzbc-g12"/>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:installation"/>
                <ruleml:Var>buvo:treatmentFacility</ruleml:Var>
                <ruleml:Data iri="nzbc-g12"/>
                <Operator iri="lovo:complyWith"/>
