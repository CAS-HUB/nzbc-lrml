      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.1.1.3">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.1.1.3">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:treatmentSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
