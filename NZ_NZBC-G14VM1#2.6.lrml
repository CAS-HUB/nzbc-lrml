                <ruleml:And>
                  <ruleml:Data iri="nzbc-g14vm1"/>
                  <ruleml:Data iri="nzbc-f3"/>
                </ruleml:And>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:storageFacility"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:And>
                  <ruleml:Data iri="nzbc-g14vm1"/>
                  <ruleml:Data iri="nzbc-f3"/>
                </ruleml:And>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:treatmentFaciity"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:And>
                  <ruleml:Data iri="nzbc-g14vm1"/>
                  <ruleml:Data iri="nzbc-f3"/>
                </ruleml:And>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.2.1.1.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.2.1.1.2">
