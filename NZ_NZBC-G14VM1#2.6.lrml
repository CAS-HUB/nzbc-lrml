    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.8.1.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.8.1.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:purpose"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="collection"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:type"/>
              <ruleml:Var>buvo:collection</ruleml:Var>
              <ruleml:Data iri="Ind.LiquidWaste"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:area"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="nzbc-d1"/>
              <Operator iri="lovo:complyWith"/>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.8.1.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.8.1.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:purpose"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="collection"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:type"/>
              <ruleml:Var>buvo:collection</ruleml:Var>
              <ruleml:Data iri="Ind.LiquidWaste"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:area"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="turningSpace"/>
              <Operator iri="lovo:adequte"/>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.8.1.3">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.8.1.3">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:purpose"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="collection"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:type"/>
              <ruleml:Var>buvo:collection</ruleml:Var>
              <ruleml:Data iri="Ind.LiquidWaste"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:drain"/>
                <ruleml:Var>buvo:spillage</ruleml:Var>
                <ruleml:Data iri="kerb"/>
                <Operator iri="lovo:towards"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Prohibition>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:flow"/>
                <ruleml:Var>buvo:spillage</ruleml:Var>
                <ruleml:Or>
                  <ruleml:Data iri="vehicle"/>
                  <ruleml:Data iri="plantArea"/>
                </ruleml:Or>
                <Operator iri="lovo:towards"/>
              </ruleml:Atom>
            </lrml:Prohibition>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.8.1.4">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.8.1.4">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:purpose"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="collection"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:type"/>
              <ruleml:Var>buvo:collection</ruleml:Var>
              <ruleml:Data iri="Ind.LiquidWaste"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
            <lrml:Permission>
              <not>
                <ruleml:Atom>
                  <ruleml:Var>buvo:spillage</ruleml:Var>
                  <ruleml:Data iri="sewer"/>
                  <Operator iri="lovo:dischargeInto"/>
                </ruleml:Atom>
              </not>
            </lrml:Permission>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:flow"/>
              <ruleml:Var>buvo:spillage</ruleml:Var>
              <ruleml:Data iri="sewer"/>
              <Operator iri="lovo:dischargeInto"/>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.8.1.5">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.8.1.5">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:purpose"/>
              <ruleml:Var>buvo:vehicleAccess</ruleml:Var>
              <ruleml:Data iri="collection"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:type"/>
              <ruleml:Var>buvo:collection</ruleml:Var>
              <ruleml:Data iri="Ind.LiquidWaste"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:disposalMethod"/>
              <ruleml:Var>buvo:spillage</ruleml:Var>
              <ruleml:Data iri="on-site"/>
              <Operator iri="lovo:contained"/>
            </ruleml:Atom>
          </lrml:Obligation>
          <ruleml:And>
            <lrml:Prohibition>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:flow"/>
                <ruleml:Var>buvo:spillage</ruleml:Var>
                <ruleml:Data iri="surfaceWaterSystem"/>
                <Operator iri="lovo:into"/>
              </ruleml:Atom>
            </lrml:Prohibition>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.9.1.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.9.1.1">
