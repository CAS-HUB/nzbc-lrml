    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_2.0.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:2.0.1">
        <!-- comment -->
        <ruleml:if>
          <lrml:Permission>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:disposalMethod"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="sewer"/>
              <Operator iri="lovo:dischargeInto"/>
            </ruleml:Atom>
          </lrml:Permission>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:Data iri="disposalSystem"/>
                <Operator iri="lovo:conveyedIn"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:disposalSystem</ruleml:Var>
                <ruleml:Data iri="nzbc-g13"/>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_2.1.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:2.1.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:blockage"/>
              <ruleml:Var>buvo:pipingSystem</ruleml:Var>
              <ruleml:Data iri="possible"/>
              <Operator iri="lovo:is "/>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:cause"/>
              <ruleml:Var>buvo:blockage</ruleml:Var>
              <ruleml:Data iri="suspendedSolid"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:atTheHeadOf"/>
                <ruleml:Var>buvo:pipingSystem</ruleml:Var>
                <ruleml:Data iri="screens"/>
                <Operator iri="lovo:has"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:atTheHeadOf"/>
                <ruleml:Var>buvo:pipingSystem</ruleml:Var>
                <ruleml:Data iri="gritChamber"/>
                <Operator iri="lovo:has"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:atTheHeadOf"/>
                <ruleml:Var>buvo:pipingSystem</ruleml:Var>
                <ruleml:Data iri="greaseTrap"/>
                <Operator iri="lovo:has"/>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_2.1.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:2.1.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            <ruleml:Data iri="pipingSystem"/>
            <Operator iri="lovo:conveyedIn"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:disposalMethod"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="gravityFlow"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_2.1.3">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:2.1.3">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="fuvo:disposalMethod"/>
            <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            <ruleml:Data iri="gravityFlow"/>
            <Operator iri="lovo:equal"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:slope"/>
                <ruleml:Var>buvo:pipeline</ruleml:Var>
                <ruleml:Data iri="sufficient"/>
                <Operator iri="lovo:is "/>
              </ruleml:Atom>
            </lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:velocity"/>
              <ruleml:Var>buvo:flow</ruleml:Var>
              <ruleml:Data iri="velocityCausingSediment"/>
              <Operator iri="lovo:greaterThan"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_2.3.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:2.3.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            <ruleml:Data iri="pipingSystem"/>
            <Operator iri="lovo:conveyedIn"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Expr>
                <ruleml:Fun value="count"/>
                <ruleml:Atom>
                  <ruleml:Rel iri="fuvo:joint"/>
                  <ruleml:Var>buvo:pipingSystem</ruleml:Var>
                  <ruleml:Data iri="minimum"/>
                  <Operator iri="lovo:is "/>
                </ruleml:Atom>
              </ruleml:Expr>
            </lrml:Obligation>
            <ruleml:Expr>
              <ruleml:Fun value="count"/>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:fitting"/>
                <ruleml:Var>buvo:pipingSystem</ruleml:Var>
                <ruleml:Data iri="minimum"/>
                <Operator iri="lovo:is "/>
              </ruleml:Atom>
            </ruleml:Expr>
            <ruleml:Expr>
              <ruleml:Fun value="count"/>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:valve"/>
                <ruleml:Var>buvo:pipingSystem</ruleml:Var>
                <ruleml:Data iri="minimum"/>
                <Operator iri="lovo:is "/>
              </ruleml:Atom>
            </ruleml:Expr>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_2.3.3.">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:2.3.3.">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="fuvo:bend"/>
            <ruleml:Var>buvo:pipingSystem</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:centrelineRadius"/>
              <ruleml:Var>buvo:bend</ruleml:Var>
              <ruleml:Data iri="1.5 * (nominalPipeDiameter)"/>
              <Operator iri="lovo:greaterThanEqual"/>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_3.2.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:3.2.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="fuvo:type"/>
            <ruleml:Var>buvo:tank</ruleml:Var>
            <ruleml:Data iri="freeStanding"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:protection"/>
                <ruleml:Var>buvo:tank</ruleml:Var>
                <ruleml:Data iri="seismic"/>
                <Operator iri="lovo:equal"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Permission>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:seismicRestraint"/>
                <ruleml:Var>buvo:tank</ruleml:Var>
                <ruleml:Data iri="nzs4219"/>
                <Operator iri="lovo:comply"/>
              </ruleml:Atom>
            </lrml:Permission>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
  </lrml:Statements>

