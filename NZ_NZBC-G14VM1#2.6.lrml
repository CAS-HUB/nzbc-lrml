          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:facilityArea</ruleml:Var>
                <ruleml:Data iri="impervious"/>
                <Operator iri="lovo:is"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Var>buvo:facilityArea</ruleml:Var>
              <ruleml:Data iri="bunded"/>
              <Operator iri="lovo:is"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.6.3">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.6.3">
