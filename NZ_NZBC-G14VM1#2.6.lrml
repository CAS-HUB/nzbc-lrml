              <ruleml:Var>buvo:Ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="1"/>
              <Operator iri="lovo:greaterThan"/>
            </ruleml:Atom>
          </ruleml:Expr>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Expr>
              <ruleml:Fun value="forEach">
                <ruleml:Atom>
                  <ruleml:Var>buvo:treatmentSystem</ruleml:Var>
                  <ruleml:Data iri="unique"/>
                  <Operator iri="lovo:is"/>
                </ruleml:Atom>
              </ruleml:Fun>
              <ruleml:Atom>
                <ruleml:Var>buvo:treatmentMethod</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Expr>
