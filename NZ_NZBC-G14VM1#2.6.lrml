    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.1.1.4">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.1.1.4">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:disposalSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:complianceMode"/>
              <ruleml:Var>buvo:collectionSystem</ruleml:Var>
              <ruleml:Data iri="specificDesign"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:disposalSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="nzbc-g14"/>
              <Operator iri="lovo:complyWith"/>
