  <lrml:Statements>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.1.1.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.1.1.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:collectionSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:complianceMode"/>
              <ruleml:Var>buvo:collectionSystem</ruleml:Var>
              <ruleml:Data iri="specificDesign"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:collectionSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="nzbc-g14vm1"/>
              <Operator iri="lovo:complyWith"/>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.1.1.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.1.1.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:storageSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:complianceMode"/>
              <ruleml:Var>buvo:collectionSystem</ruleml:Var>
              <ruleml:Data iri="specificDesign"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:storageSystem"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="nzbc-g14vm1"/>
              <Operator iri="lovo:complyWith"/>
            </ruleml:Atom>
