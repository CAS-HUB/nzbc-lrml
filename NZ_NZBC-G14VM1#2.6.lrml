    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.4.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.4.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:strength"/>
              <ruleml:Var>buvo:storageTank</ruleml:Var>
              <ruleml:Data iri="structLoad"/>
              <Operator iri="lovo:greaterThan"/>
            </ruleml:Atom>
            <not>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:type"/>
                <ruleml:Var>buvo:environment</ruleml:Var>
                <ruleml:Data iri="hazardous"/>
                <Operator iri="lovo:equal"/>
              </ruleml:Atom>
            </not>
            <not>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:type"/>
                <ruleml:Var>buvo:environment</ruleml:Var>
                <ruleml:Data iri="corrosive"/>
                <Operator iri="lovo:equal"/>
              </ruleml:Atom>
            </not>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Permission>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:location"/>
              <ruleml:Var>buvo:storageTank</ruleml:Var>
              <ruleml:Data iri="groundLevel"/>
              <Operator iri="lovo:below"/>
            </ruleml:Atom>
          </lrml:Permission>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.5.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.5.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Var>buvo:constructionMaterial</ruleml:Var>
            <ruleml:Data iri="ind.LiquidWaste"/>
            <Operator iri="lovo:inContact"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:constructionMaterial</ruleml:Var>
                <ruleml:Data iri="corrosion"/>
                <Operator iri="lovo:resistantTo"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:constructionMaterial</ruleml:Var>
                <ruleml:Data iri="chemicalAttack"/>
                <Operator iri="lovo:resistantTo"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:constructionMaterial</ruleml:Var>
                <ruleml:Data iri="abrasion"/>
                <Operator iri="lovo:resistantTo"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:constructionMaterial</ruleml:Var>
                <ruleml:Data iri="physicalAbuse"/>
                <Operator iri="lovo:resistantTo"/>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.5.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.5.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Var>buvo:handlingEquipment</ruleml:Var>
            <ruleml:Data iri="corrosion"/>
            <Operator iri="lovo:resistantTo"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:durability"/>
              <ruleml:Var>buvo:handlingEquipment</ruleml:Var>
              <ruleml:Data iri="lifetime"/>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.6.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.6.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Var>buvo:installation</ruleml:Var>
              <ruleml:And>
                <ruleml:Data iri="ind.LiquidWasteSystem"/>
                <ruleml:Data iri="storageTank"/>
                <ruleml:Data iri="treatmentTank"/>
                <ruleml:Data iri="piping"/>
              </ruleml:And>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:status"/>
              <ruleml:Var>buvo:installation</ruleml:Var>
              <ruleml:Data iri="completed"/>
              <Operator iri="lovo:equal"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Var>buvo:installation</ruleml:Var>
                <ruleml:Data iri="testing"/>
                <Operator iri="lovo:require"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:protection"/>
                <ruleml:Var>buvo:naturalWaterway</ruleml:Var>
                <ruleml:Data iri="contamination"/>
                <Operator iri="lovo:from"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:protection"/>
                <ruleml:Var>buvo:groundWater</ruleml:Var>
                <ruleml:Data iri="contamination"/>
                <Operator iri="lovo:from"/>
              </ruleml:Atom>
            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.6.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.6.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="fuvo:storageFacility"/>
