    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.1.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.1.2">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="fuvo:type"/>
            <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            <ruleml:Data iri="hazardous"/>
            <Operator iri="lovo:equal"/>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <ruleml:And>
            <lrml:Obligation>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:storageFacility"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:Data iri="nzbc-g14vm1"/>
                <Operator iri="lovo:complyWith"/>
              </ruleml:Atom>
            </lrml:Obligation>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:storageFacility"/>
              <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="nzbc-f3"/>
              <Operator iri="lovo:complyWith"/>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.2.1.1.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.2.1.1.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Atom>
            <ruleml:Rel iri="fuvo:type"/>
            <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
            <ruleml:Data iri="hazardous"/>
            <Operator iri="lovo:is"/>
          </ruleml:Atom>
