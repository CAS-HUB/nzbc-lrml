            </lrml:Obligation>
          </ruleml:And>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.7.1">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.7.1">
        <!-- comment -->
        <ruleml:if>
          <ruleml:Expr>
            <ruleml:Fun value="count"/>
            <ruleml:Atom>
              <ruleml:Rel iri="fuvo:disposalMethod"/>
              <ruleml:Var>buvo:Ind.LiquidWaste</ruleml:Var>
              <ruleml:Data iri="1"/>
              <Operator iri="lovo:greaterThan"/>
            </ruleml:Atom>
          </ruleml:Expr>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation>
            <ruleml:Expr>
              <ruleml:Fun value="forEach">
                <ruleml:Atom>
                  <ruleml:Var>buvo:disposalSystem</ruleml:Var>
                  <ruleml:Data iri="unique"/>
                  <Operator iri="lovo:is"/>
                </ruleml:Atom>
              </ruleml:Fun>
              <ruleml:Atom>
                <ruleml:Var>buvo:disposalMethod</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Expr>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.7.2">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.7.2">
