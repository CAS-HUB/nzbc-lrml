    <lrml:PrescriptiveStatement key="NZBC-NZBC.G14VM1_x003A_1.2.1.1.3">
      <ruleml:Rule key="NZBC-NZBC.G14VM1:1.2.1.1.3">
        <!-- comment -->
        <ruleml:if>
          <ruleml:And>
            <not>
              <ruleml:Atom>
                <ruleml:Rel iri="fuvo:type"/>
                <ruleml:Var>buvo:ind.LiquidWaste</ruleml:Var>
                <ruleml:Data iri="hazardous"/>
                <Operator iri="lovo:is"/>
