        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.2.9.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.2.9.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:uses"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>solarWaterHeaterSealant</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:solarWaterHeaterSealant</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>neutralCureSiliconeSealant</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:useWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:solarWaterHeaterSealant</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>mechanicalFasteners</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.2.9.0.1.a.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.2.9.0.1.a.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:uses"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>solarWaterHeaterSealant</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarWaterHeaterSealant</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>ISO11600.TypeF</ruleml:Data>
                                <ruleml:Data> ISO11600.Class20LM</ruleml:Data>
                                <ruleml:Data> ISO11600.Class25LM</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.2.9.0.1.b.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.2.9.0.1.b.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.2.10.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.2.10.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:uses"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>solarWaterHeaterSealant</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarWaterHeaterSealant</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>aceticCuredSiliconeSealant</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Prohibition>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:usedOn"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:aceticCuredSiliconeSealant</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>zinc</ruleml:Data>
                                <ruleml:Data>aluminiumZincCoating</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                    </lrml:Prohibition>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.2.11.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.2.11.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.2.12.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.2.12.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:fixings or roofPenetration</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:through"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:fixings or roofPenetration</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>roofCladdingCrest</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.3.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.3.1.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:pipes and pipeSupports</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:pipes and pipeSupports</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Or>
                                <ruleml:Data>electrochemicallyCompatible</ruleml:Data>
                                <ruleml:Data>electrolyticallySeparated</ruleml:Data>
                            </ruleml:Or>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.3.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.3.2.0.1">
                <ruleml:if>
                    <ruleml:Not>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:requires"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:installed"/>
                                <ruleml:Var>buvo:pipes</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>anchorPoints</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Not>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:permits"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pipes</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>thermalMovement</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:permits"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:pipeSupports</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>thermalMovement</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.3.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.3.3.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.4.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.4.1.0.1">
                <ruleml:if>
                    <ruleml:Not>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:connectedTo"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:hotWaterPipe</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>heatDissipationDevice</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Not>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:hotWaterPipe</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.h1.3.4</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_5.4.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:5.4.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_c5.4.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:c5.4.2.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.1.1.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.1.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.2.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:installed"/>
                            <ruleml:Var>buvo:solarCollector</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <lrml:Prohibition>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:dentBendOrDistort"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:solarCollector</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>roofCladding</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Prohibition>
                        <lrml:Prohibition>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:damage"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:solarCollector</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>protectiveCoating</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Prohibition>
                    </ruleml:Or>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.3.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:penetrate"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:fixings</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>metalCladding</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:providedWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:fixings</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Or>
                                    <ruleml:Data>sealingWashers</ruleml:Data>
                                    <ruleml:Data>boots</ruleml:Data>
                                </ruleml:Or>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:fixings</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>nzbc.g12as2.5.2</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_c6.2.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:c6.2.3.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.4.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.4.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:has"/>
                        <ruleml:Atom>
                            <ruleml:Rel iri="buvo:installation"/>
                            <ruleml:Var>buvo:solarCollector</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>support</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:quantities"/>
                                    <ruleml:Var>buvo:support</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>4</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:within"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:outermost"/>
                                    <ruleml:Var>buvo:support</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>200 mm of outside edge of solarCollector</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.4.0.2">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.4.0.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:installation"/>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>support</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:location"/>
                                <ruleml:Var>buvo:support</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>outermost</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:centreline"/>
                                <ruleml:Var>buvo:support</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>x</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:is"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:outsideEdge"/>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>y</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:inBetween"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:dimension"/>
                                    <ruleml:Var>buvo:installation</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:And>
                                    <ruleml:Data>x</ruleml:Data>
                                    <ruleml:Data>y</ruleml:Data>
                                </ruleml:And>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:dimension"/>
                                    <ruleml:Var>buvo:installation</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>200 mm</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.5.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.5.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.2.6.0.1.a.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.2.6.0.1.a.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:has"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:roof</ruleml:Var>
