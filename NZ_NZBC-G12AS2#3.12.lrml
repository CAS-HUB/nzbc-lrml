    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_1.0.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:1.0.1.0.1">
                <ruleml:if>
                    <ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:in"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:installation"/>
                                <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>building</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:on"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:installation"/>
                                <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>building</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Or>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g12as2</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_1.0.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:1.0.2.0.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:complyWith"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>nzbc.g12as2</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarWaterHeater</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>nzbc.g12as1</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_1.0.2.0.2">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:1.0.2.0.2">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:nzbc.g12as2</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Data>TRUE</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:complyWith"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:nzbc.g12as2</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:And>
                            <ruleml:Data>nzbc.b1</ruleml:Data>
                            <ruleml:Data>ncbz.b2</ruleml:Data>
                            <ruleml:Data>nzbc.e2</ruleml:Data>
                            <ruleml:Data>nzbc.g12</ruleml:Data>
                            <ruleml:Data>nzbc.h1</ruleml:Data>
                        </ruleml:And>
                    </ruleml:Expr>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_1.0.3.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:1.0.3.0.1"/>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_1.1.1.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:1.1.1.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:designedToSupport"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>solarWaterHeater</ruleml:Data>
                            </ruleml:Not>
                        </ruleml:Not>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:on"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:installation"/>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>building</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:weight"/>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>w1</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:weight"/>
                                <ruleml:Var>buvo:frame</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>w2</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:weight"/>
                                <ruleml:Var>buvo:fitting</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>w3</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:weight"/>
                                <ruleml:Var>buvo:heatTransferFluid</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>w4</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:combinedWeight</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>w1+w2+w3+w4</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:grossArea"/>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>a</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:unitWeight</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>combinedWeight/a</ruleml:Data>
                        </ruleml:Expr>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:unitWeight</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>22 kg per m^2</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:on"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:installation"/>
                                    <ruleml:Var>buvo:tank</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>roof</ruleml:Data>
                            </ruleml:Not>
                        </ruleml:Not>
                        <ruleml:Not>
                            <ruleml:Not>
                                <ruleml:Fun iri="lovo:above"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:installation"/>
                                    <ruleml:Var>buvo:tank</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>roof</ruleml:Data>
                            </ruleml:Not>
                        </ruleml:Not>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Permission>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:support"/>
                                    <ruleml:Var>buvo:solarCollector</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>nzbc-g12as2</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Permission>
                        <lrml:Permission>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:fixing"/>
                                    <ruleml:Var>buvo:solarCollector</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>nzbc-g12as2</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Permission>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:structure"/>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Or>
                                    <ruleml:Data>nzs3604-1990</ruleml:Data>
                                    <ruleml:Data>nzs3604-1999</ruleml:Data>
                                    <ruleml:Data>nzs3604-2011</ruleml:Data>
                                    <ruleml:Data>nzs4203</ruleml:Data>
                                    <ruleml:Data>asnzs1170.0</ruleml:Data>
                                    <ruleml:Data>asnzs1170.1</ruleml:Data>
                                    <ruleml:Data>asnzs1170.2</ruleml:Data>
                                    <ruleml:Data>asnzs1170.3</ruleml:Data>
                                    <ruleml:Data>asnzs1170.5</ruleml:Data>
                                </ruleml:Or>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
