        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_6.4.2.0.1">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:6.4.2.0.1">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:mountedParallelTo"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>roof</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:elevated"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarCollector</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>&lt;= 50 mm above the roof cladding</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <ruleml:And>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:supportedBy"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:solarCollector</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>underlyingPurlins</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:complyWith"/>
                                    <ruleml:Atom>
                                        <ruleml:Var>buvo:underlyingPurlins</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Or>
                                        <ruleml:Data>nzbc.g12.as2.6.4.1 .a</ruleml:Data>
                                        <ruleml:Data>nzbc.g12.as2.6.4.1.b</ruleml:Data>
                                    </ruleml:Or>
                                </ruleml:Expr>
                            </lrml:Obligation>
                        </ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:connections"/>
                                    <ruleml:Var>buvo:underlyingRafters or trusses</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Or>
                                    <ruleml:Data>nzbc.g12.as2.6.4.1 .a</ruleml:Data>
                                    <ruleml:Data>nzbc.g12.as2.6.4.1.c</ruleml:Data>
                                </ruleml:Or>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:collectorSupportRails</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>nzbc.g12.as2.6.5</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:Or>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
