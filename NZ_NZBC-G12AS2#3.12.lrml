                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Var>buvo:solarEnergyFactor</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data iri="0.85"/>
                        </ruleml:Expr>
                    </lrml:Obligation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="NZBC-NZBC.G12AS2_x003A_nzs4614.1986.2">
            <ruleml:Rule key="NZBC-NZBC.G12AS2:nzs4614.1986.2">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:flatPlateCollectorInclination</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="0 deg"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThan"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:flatPlateCollectorInclination</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="20 deg"/>
                            </ruleml:Expr>
                        </ruleml:And>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:greaterThanEqual"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:flatPlateCollectorOrientation</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="180 deg"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:lessThan"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:flatPlateCollectorOrientation</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="270 deg"/>
                            </ruleml:Expr>
                        </ruleml:And>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Obligation>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:flatPlateCollectorInclination</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="x deg"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:a1</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="0"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:a2</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="0.85"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:b1</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="20"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Var>buvo:b2</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="0.85"/>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:formula"/>
                                    <ruleml:Var>buvo:solarEnergyFactor</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data iri="a2+((x-a1)*(b2-a2)/(b1-a1))"/>
                            </ruleml:Expr>
