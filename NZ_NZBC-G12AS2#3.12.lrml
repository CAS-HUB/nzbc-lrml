            <ruleml:Rule key="NZBC-NZBC.G12AS2:nzs4614.1986.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:equal"/>
                        <ruleml:Atom>
