    <lrml:Statements>
        <lrml:PrescriptiveStatement key="NZ_NZBC-G1AS1_x0023_2.6_r1.1.1">
            <ruleml:Rule key="urn:cas:nzbc-lrml:NZ_NZBC-G1AS1%232.6:rule:NZ_NZBC-G1AS1%232.6_r1.1.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:greaterThan"/>
                        <ruleml:Expr>
                            <ruleml:Fun iri="fuvo:count"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:occupantLoad"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                        </ruleml:Expr>
                        <ruleml:Data xsi:type="xs:integer">0</ruleml:Data>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
