                            </ruleml:Atom>
                            <ruleml:Data>TRUE</ruleml:Data>
                        </ruleml:Expr>
                        <lrml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:support"/>
                                    <ruleml:Var>buvo:wall</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>continuous</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Not>
                        <lrml:Not>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:is"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:type"/>
                                    <ruleml:Var>buvo:support</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Or>
                                    <ruleml:Data>joist</ruleml:Data>
                                    <ruleml:Data>solidBlocking</ruleml:Data>
                                    <ruleml:Data>concreteSlab</ruleml:Data>
                                </ruleml:Or>
                            </ruleml:Expr>
                        </lrml:Not>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:And>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:complyWith"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:dimension"/>
                                    <ruleml:Var>buvo:bottomPlate</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>table</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                        <lrml:Obligation>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:equal"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:key"/>
                                    <ruleml:Var>buvo:table</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>t8.17</ruleml:Data>
                            </ruleml:Expr>
                        </lrml:Obligation>
                    </ruleml:And>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
