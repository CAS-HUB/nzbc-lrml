	<lrml:Statements key="SNZHB3604">
		<lrml:PrescriptiveStatement key="SNZHB3604-2011_x003A_1.1.3.0.1">
            <ruleml:Rule key="SNZHB3604-2011:1.1.3.0.1">
                <ruleml:if>
                    <ruleml:Or>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:loading"/>
                                <ruleml:Var>buvo:floor</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>2.0 kPa</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:greaterThan"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:loading"/>
                                <ruleml:Var>buvo:snow</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>1.5 kPa</ruleml:Data>
                        </ruleml:Expr>
                        <ruleml:And>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:asPer"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:classification"/>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>table</ruleml:Data>
                            </ruleml:Expr>
                            <ruleml:Expr>
                                <ruleml:Fun iri="lovo:asPer"/>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="buvo:classification"/>
                                    <ruleml:Var>buvo:building</ruleml:Var>
                                </ruleml:Atom>
                                <ruleml:Data>table</ruleml:Data>
                            </ruleml:Expr>
                        </ruleml:And>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:equal"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:key"/>
                                <ruleml:Var>buvo:table</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>t1.1b</ruleml:Data>
                        </ruleml:Expr>
                    </ruleml:Or>
                </ruleml:if>
                <ruleml:then>
                    <lrml:Prohibition>
                        <ruleml:Expr>
                            <ruleml:Fun iri="lovo:complyWith"/>
                            <ruleml:Atom>
                                <ruleml:Rel iri="buvo:design"/>
                                <ruleml:Var>buvo:building</ruleml:Var>
                            </ruleml:Atom>
                            <ruleml:Data>SNZHB3604</ruleml:Data>
                        </ruleml:Expr>
                    </lrml:Prohibition>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <lrml:PrescriptiveStatement key="SNZHB3604-2011_x003A_2.4.1">
            <ruleml:Rule key="SNZHB3604-2011:2.4.1">
                <ruleml:if>
                    <ruleml:Expr>
                        <ruleml:Fun iri="lovo:is"/>
                        <ruleml:Atom>
                            <ruleml:Var>buvo:structure</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Or>
                            <ruleml:Data>subfloor</ruleml:Data>
                            <ruleml:Data>foundation</ruleml:Data>
                        </ruleml:Or>
                    </ruleml:Expr>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Or>
                        <ruleml:And>
                            <lrml:Obligation>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:is"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:type"/>
                                        <ruleml:Var>buvo:pile</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>ordinary</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Obligation>
                            <lrml:Permission>
                                <ruleml:Expr>
                                    <ruleml:Fun iri="lovo:is"/>
                                    <ruleml:Atom>
                                        <ruleml:Rel iri="buvo:installation"/>
                                        <ruleml:Var>buvo:pile</ruleml:Var>
                                    </ruleml:Atom>
                                    <ruleml:Data>driven</ruleml:Data>
                                </ruleml:Expr>
                            </lrml:Permission>
                        </ruleml:And>
                        <ruleml:And>
                            <lrml:Obligation>
                                <ruleml:Expr>
