		<lrml:PrescriptiveStatement key="SNZ.HB.3604_x003A_t6.1.1">
			<ruleml:Rule key="SNZ.HB.3604:t6.1.1">
				<ruleml:if>
					<ruleml:And>
						<ruleml:Or>
							<ruleml:Expr>
								<ruleml:Fun iri="lovo:equal"/>
								<ruleml:Atom>
									<ruleml:Rel iri="buvo:structuralLoading"/>
									<ruleml:Var>buvo:floor</ruleml:Var>
								</ruleml:Atom>
								<ruleml:Data>1.5 kPa</ruleml:Data>
							</ruleml:Expr>
							<ruleml:Expr>
								<ruleml:Fun iri="lovo:equal"/>
								<ruleml:Atom>
									<ruleml:Rel iri="buvo:structuralLoading"/>
									<ruleml:Var>buvo:floor</ruleml:Var>
								</ruleml:Atom>
								<ruleml:Data>2 kPa</ruleml:Data>
							</ruleml:Expr>
						</ruleml:Or>
						<ruleml:Or>
							<ruleml:Expr>
								<ruleml:Fun iri="lovo:for"/>
								<ruleml:Atom>
									<ruleml:Rel iri="buvo:support"/>
									<ruleml:Var>buvo:footing</ruleml:Var>
								</ruleml:Atom>
								<ruleml:Data>floor</ruleml:Data>
							</ruleml:Expr>
							<ruleml:Expr>
								<ruleml:Fun iri="lovo:for"/>
								<ruleml:Atom>
									<ruleml:Rel iri="buvo:support"/>
									<ruleml:Var>buvo:footing</ruleml:Var>
								</ruleml:Atom>
								<ruleml:Data>nonLoadBearingWall</ruleml:Data>
							</ruleml:Expr>
						</ruleml:Or>
						<ruleml:Expr>
							<ruleml:Fun iri="lovo:is"/>
							<ruleml:Atom>
								<ruleml:Rel iri="buvo:crossSectionalShape"/>
								<ruleml:Var>buvo:footing</ruleml:Var>
							</ruleml:Atom>
							<ruleml:Data>square</ruleml:Data>
						</ruleml:Expr>
						<ruleml:Expr>
							<ruleml:Fun iri="lovo:equal"/>
							<ruleml:Atom>
								<ruleml:Rel iri="buvo:averageSpan"/>
								<ruleml:Var>buvo:bearer</ruleml:Var>
							</ruleml:Atom>
							<ruleml:Data>1.3 m</ruleml:Data>
						</ruleml:Expr>
						<ruleml:Expr>
							<ruleml:Fun iri="lovo:equal"/>
							<ruleml:Atom>
								<ruleml:Rel iri="buvo:averageSpan"/>
								<ruleml:Var>buvo:joist</ruleml:Var>
							</ruleml:Atom>
							<ruleml:Data>2.0 m</ruleml:Data>
						</ruleml:Expr>
					</ruleml:And>
				</ruleml:if>
				<ruleml:then>
					<lrml:Obligation>
						<ruleml:Expr>
							<ruleml:Fun iri="lovo:greaterThanEqual"/>
							<ruleml:Atom>
								<ruleml:Rel iri="buvo:planDimention"/>
								<ruleml:Var>buvo:footing</ruleml:Var>
